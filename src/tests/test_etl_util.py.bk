class TestWriteViewToMSSQL(unittest.TestCase):
    """Test write_view_to_mssql function."""

    @patch('etls.reports.etl_util.F')
    @patch('etls.reports.etl_util.execute_scon_query')
    @patch('etls.reports.etl_util.write_df_to_scon')
    @patch('etls.reports.etl_util.replace_empty_with_NULL_string')
    @patch('etls.reports.etl_util.generate_sql_server_ddl')
    @patch('etls.reports.etl_util.logger')
    def test_write_view_to_mssql_success(
        self, mock_logger, mock_ddl, mock_replace_empty,
        mock_write_scon, mock_execute_scon, mock_f
    ):
        """Test successful write to MSSQL."""
        mock_spark = MagicMock(spec=SparkSession)
        mock_df = MagicMock(spec=DataFrame)
        mock_df.columns = ["col1", "col2", "REPORT_DATE"]
        mock_df.withColumn.return_value = mock_df

        mock_table = MagicMock()
        mock_table.name = "temp_view"
        mock_spark.catalog.listTables.return_value = [mock_table]
        mock_spark.table.return_value = mock_df

        mock_replace_empty.return_value = mock_df
        mock_ddl.return_value = "CREATE TABLE..."

        # Mock F functions
        mock_f.to_date.return_value = MagicMock()
        mock_f.col.return_value = MagicMock()
        mock_f.when.return_value = MagicMock()
        mock_f.lit.return_value = MagicMock()

        mssql_config = {
            "connection_url": "jdbc:sqlserver://host",
            "username": "user",
            "password": "pwd",
            "database": "testdb"
        }

        table_config = {
            "table_name": "output_table",
            "batch_size": 1000
        }

        etl_util.write_view_to_mssql(
            mock_spark,
            "temp_view",
            mssql_config,
            table_config,
            "2025-12-03"
        )

        mock_execute_scon.assert_called_once()
        mock_write_scon.assert_called_once()

    @patch('etls.reports.etl_util.logger')
    def test_write_view_to_mssql_invalid_view(self, mock_logger):
        """Test write with invalid view name."""
        mock_spark = MagicMock(spec=SparkSession)
        mock_table = MagicMock()
        mock_table.name = "other_view"
        mock_spark.catalog.listTables.return_value = [mock_table]

        mssql_config = {
            "connection_url": "jdbc:sqlserver://host",
            "username": "user",
            "password": "pwd",
            "database": "testdb"
        }

        table_config = {"table_name": "output_table"}

        with self.assertRaises(ValueError):
            etl_util.write_view_to_mssql(
                mock_spark,
                "invalid_view",
                mssql_config,
                table_config,
                "2025-12-03"
            )

        mock_logger.error.assert_called()


class TestLoadViewsFromPartition(unittest.TestCase):
    @patch('etls.reports.etl_util.replace_bucket_keys')
    @patch('etls.reports.etl_util.validate')
    @patch('etls.reports.etl_util.replace_empty_with_NULL_string')
    @patch('etls.reports.etl_util.logger')
    def test_load_views_from_partition_parquet(
        self, mock_logger, mock_replace_empty, mock_validate, mock_replace_keys
    ):
        """Test loading parquet file from partition."""
        mock_s3_client = MagicMock()
        mock_spark = MagicMock(spec=SparkSession)
        mock_reader = MagicMock()
        mock_spark.read.format.return_value = mock_reader
        mock_reader.load.return_value = MagicMock(spec=DataFrame)

        mock_replace_keys.return_value = "s3://bucket"
        mock_replace_empty.return_value = MagicMock(spec=DataFrame)

        file_config = [
            {
                "view_name": "sales",
                "format": "parquet",
                "path": "/data/sales",
                "date_partition_key": "REPORT_DATE",
                "empty_check": False
            }
        ]

        etl_util.load_views_from_partition(
            mock_s3_client,
            mock_spark,
            "s3://bucket",
            file_config,
            "2025-12-03",
            upper_col_name=True
        )

        mock_spark.read.format.assert_called_with("parquet")
        mock_logger.info.assert_called()

    @patch('etls.reports.etl_util.replace_bucket_keys')
    @patch('etls.reports.etl_util.validate')
    @patch('etls.reports.etl_util.replace_empty_with_NULL_string')
    @patch('etls.reports.etl_util.logger')
    def test_load_views_from_partition_csv(
        self, mock_logger, mock_replace_empty, mock_validate, mock_replace_keys
    ):
        """Test loading CSV file from partition."""
        mock_s3_client = MagicMock()
        mock_spark = MagicMock(spec=SparkSession)
        mock_reader = MagicMock()
        mock_spark.read.format.return_value = mock_reader
        mock_reader.option.return_value = mock_reader
        mock_reader.load.return_value = MagicMock(spec=DataFrame)

        mock_replace_keys.return_value = "s3://bucket"
        mock_replace_empty.return_value = MagicMock(spec=DataFrame)

        file_config = [
            {
                "view_name": "inventory",
                "format": "csv",
                "path": "/data/inventory",
                "empty_check": False
            }
        ]

        etl_util.load_views_from_partition(
            mock_s3_client,
            mock_spark,
            "s3://bucket",
            file_config,
            "2025-12-03",
            upper_col_name=False
        )

        mock_spark.read.format.assert_called_with("csv")

    @patch('etls.reports.etl_util.replace_bucket_keys')
    @patch('etls.reports.etl_util.logger')
    def test_load_views_from_partition_unsupported_format(
        self, mock_logger, mock_replace_keys
    ):
        """Test with unsupported file format."""
        mock_s3_client = MagicMock()
        mock_spark = MagicMock(spec=SparkSession)
        mock_replace_keys.return_value = "s3://bucket"

        file_config = [
            {
                "view_name": "data",
                "format": "json",
                "path": "/data/json",
                "empty_check": False
            }
        ]

        with self.assertRaises(ValueError):
            etl_util.load_views_from_partition(
                mock_s3_client,
                mock_spark,
                "s3://bucket",
                file_config,
                "2025-12-03"
            )

        mock_logger.error.assert_called()


class TestExecuteSQL(unittest.TestCase):
    """Test execute_sql function."""

    @patch('etls.reports.etl_util.logger')
    def test_execute_sql_success(self, mock_logger):
        """Test successful SQL execution."""
        mock_spark = MagicMock(spec=SparkSession)
        mock_df = MagicMock(spec=DataFrame)
        mock_spark.sql.return_value = mock_df

        etl_util.execute_sql(
            mock_spark,
            "result_view",
            "SELECT * FROM source_view WHERE id > 10"
        )

        mock_spark.sql.assert_called_once_with(
            "SELECT * FROM source_view WHERE id > 10"
        )
        mock_df.createOrReplaceTempView.assert_called_with("result_view")
        mock_logger.info.assert_called()

    @patch('etls.reports.etl_util.logger')
    def test_execute_sql_empty_query(self, mock_logger):
        """Test with empty query."""
        mock_spark = MagicMock(spec=SparkSession)
        mock_df = MagicMock(spec=DataFrame)
        mock_spark.sql.return_value = mock_df

        etl_util.execute_sql(mock_spark, "view", "")

        mock_spark.sql.assert_called_once_with("")


