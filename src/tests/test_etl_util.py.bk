class TestProcessConfigs(unittest.TestCase):
    """Test process_configs function."""

    @patch('etls.reports.etl_util.get_spark_session_v2')
    @patch('etls.reports.etl_util.get_config_root')
    @patch('etls.reports.etl_util.boto3.client')
    @patch('etls.reports.etl_util.logger')
    def test_process_configs_success(
        self, mock_logger, mock_boto3_client, mock_config, mock_spark_session
    ):
        """Test successful process_configs execution."""
        mock_config.return_value = {
            "root": {
                "MASTER_URL": "spark://master:7077",
                "SPARK_L2_DRIVER_MEMORY": "4g",
                "SPARK_L2_EXECUTOR_MEMORY": "4g",
                "SPARK_ML_D_I_CORES": 2,
                "SPARK_ML_E_I_CORES": 2,
                "MAX_NUMBER_OF_EXECUTORS": 4,
                "AWS_ACCESS_KEY_ID": "key",
                "AWS_SECRET_ACCESS_KEY": "secret",
                "END_POINT": "http://localhost:9000",
                "mssql_connection_url": "jdbc:sqlserver://host",
                "mssql_username": "user",
                "mssql_pwd": "pwd",
                "mssql_db": "testdb"
            }
        }

        mock_spark = MagicMock(spec=SparkSession)
        mock_spark_session.return_value = mock_spark
        mock_s3 = MagicMock()
        mock_boto3_client.return_value = mock_s3

        spark, mssql_config, yaml_path, s3_client = etl_util.process_configs(
            "test_job",
            "dev",
            "/path/to/config.yaml",
            "2025-12-03"
        )

        self.assertEqual(spark, mock_spark)
        self.assertIn("connection_url", mssql_config)
        self.assertEqual(mssql_config["username"], "user")
        self.assertEqual(s3_client, mock_s3)
        mock_logger.info.assert_called()

    @patch('etls.reports.etl_util.get_config_root')
    def test_process_configs_vault_file_path(self, mock_config):
        """Test that process_configs uses correct vault file path."""
        mock_config.return_value = {
            "root": {
                "MASTER_URL": "spark://master:7077",
                "SPARK_L2_DRIVER_MEMORY": "4g",
                "SPARK_L2_EXECUTOR_MEMORY": "4g",
                "SPARK_ML_D_I_CORES": 2,
                "SPARK_ML_E_I_CORES": 2,
                "MAX_NUMBER_OF_EXECUTORS": 4,
                "AWS_ACCESS_KEY_ID": "key",
                "AWS_SECRET_ACCESS_KEY": "secret",
                "END_POINT": "http://localhost:9000",
                "mssql_connection_url": "jdbc:sqlserver://host",
                "mssql_username": "user",
                "mssql_pwd": "pwd",
                "mssql_db": "testdb"
            }
        }

        with patch('etls.reports.etl_util.get_spark_session_v2'):
            with patch('etls.reports.etl_util.boto3.client'):
                try:
                    etl_util.process_configs(
                        "test_job",
                        "dev",
                        "/path/to/config.yaml",
                        "2025-12-03"
                    )
                except Exception:
                    pass

        mock_config.assert_called_with("/rbc_vault/secrets/reports_activity_pr1.properties")


class TestTypeAliases(unittest.TestCase):
    """Test type aliases and constants."""

    def test_query_dict_type(self):
        """Test QueryDict type alias."""
        query_dict: etl_util.QueryDict = {
            "query1": "SELECT * FROM table1",
            "query2": "SELECT * FROM table2"
        }
        self.assertEqual(len(query_dict), 2)
        self.assertIn("query1", query_dict)

    def test_func_dict_type(self):
        """Test FuncDict type alias."""
        def dummy_func(*args, **kwargs):
            pass

        func_dict: etl_util.FuncDict = {
            "func1": dummy_func
        }
        self.assertIn("func1", func_dict)
        self.assertEqual(func_dict["func1"], dummy_func)


class TestProcessConfigTypeDict(unittest.TestCase):
    """Test ProcessConfig TypedDict."""

    def test_process_config_with_steps(self):
        """Test ProcessConfig with steps."""
        config: etl_util.ProcessConfig = {
            "steps": [
                {"function": "load_views", "s3_base_path": "s3://bucket"}
            ]
        }
        self.assertIn("steps", config)
        self.assertEqual(len(config["steps"]), 1)

    def test_process_config_empty(self):
        """Test ProcessConfig empty."""
        config: etl_util.ProcessConfig = {}
        self.assertNotIn("steps", config)





if __name__ == "__main__":
    unittest.main()

