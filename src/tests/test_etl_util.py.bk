        mock_s3_client = MagicMock()
        mock_spark = MagicMock(spec=SparkSession)
        mock_load_views.side_effect = Exception("Load failed")

        mssql_config = {
            "connection_url": "jdbc:sqlserver://host",
            "username": "user",
            "password": "pwd",
            "database": "db"
        }

        config = {
            "steps": [
                {
                    "function": "load_views",
                    "s3_base_path": "s3://bucket",
                    "files": []
                }
            ]
        }

        with self.assertRaises(Exception):
