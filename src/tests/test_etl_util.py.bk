            )


class TestLoadMSSQLViewAsDF(unittest.TestCase):
    """Test load_mssql_view_as_df function."""

    @patch('etls.reports.etl_util.logger')
    def test_load_mssql_view_as_df_success(self, mock_logger):
        """Test successful MSSQL view load."""
        mock_spark = MagicMock(spec=SparkSession)
        mock_reader = MagicMock()
        mock_spark.read.format.return_value = mock_reader
        mock_reader.option.return_value = mock_reader
        mock_reader.load.return_value = MagicMock(spec=DataFrame)

        mssql_config = {
            "connection_url": "jdbc:sqlserver://host:1433",
            "username": "user",
            "password": "pwd",
            "database": "testdb"
        }

        result = etl_util.load_mssql_view_as_df(
            mock_spark,
            mssql_config,
            "test_view",
            "SELECT * FROM test"
        )

        self.assertIsNotNone(result)
        mock_spark.read.format.assert_called_with("jdbc")
        mock_logger.info.assert_called()

    @patch('etls.reports.etl_util.logger')
    def test_load_mssql_view_as_df_failure(self, mock_logger):
        """Test MSSQL view load failure."""
        mock_spark = MagicMock(spec=SparkSession)
        mock_spark.read.format.side_effect = Exception("Connection error")

        mssql_config = {
            "connection_url": "jdbc:sqlserver://host:1433",
            "username": "user",
            "password": "pwd",
            "database": "testdb"
        }

        with self.assertRaises(Exception):
            etl_util.load_mssql_view_as_df(
                mock_spark,
                mssql_config,
                "test_view",
                "SELECT * FROM test"
            )

        mock_logger.error.assert_called()


class TestLoadMSSQLTableAsSparkTempTable(unittest.TestCase):
