def replace_bucket_keys(path: str) -> str:
    """Replace tokens in an S3 path (stub – override if needed)."""
    return path


def next_day(report_date: str, base_path: str) -> str:
    """
    Build the partition path for the given date.
    The real implementation may be different; here we just append the date.
    """
    if base_path.endswith("/"):
        return f"{base_path}{report_date}"
    return f"{base_path}/{report_date}"


def validate(df: DataFrame, view_name: str, empty_check: bool) -> None:
    """Stub validation hook."""
    return None


def replace_empty_with_NULL_string(df: DataFrame) -> DataFrame:
    """
    Replace empty string values with NULL for all string columns.
    This is deterministic and safe for tests.
    """
    string_cols = [
        f.name for f in df.schema.fields if str(f.dataType) == "StringType"
    ]
    for c in string_cols:
        df = df.withColumn(
            c, F.when(F.col(c) == "", F.lit(None)).otherwise(F.col(c))
        )
    return df


