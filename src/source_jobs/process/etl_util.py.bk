def process_configs(
    job_name: str,
    vault_env: str,
    report_yaml_path: str,
    file_date: str,
):
    """
    Read Vault config, build MSSQL config, create SparkSession & S3 client.
    Returns (spark, mssql_config, report_yaml_full_path, s3_client).
    """
    vault_file = "/rbc_vault/secrets/reports_activity_pr1.properties"
    config = get_config_root(vault_file)
    root = config["root"]

    master_url = root["MASTER_URL"]
    driver_memory = root["SPARK_L2_DRIVER_MEMORY"]
    executor_memory = root["SPARK_L2_EXECUTOR_MEMORY"]
    driver_cores = root["SPARK_ML_D_I_CORES"]
    executor_cores = root["SPARK_ML_E_I_CORES"]
    max_number_of_executors = root["MAX_NUMBER_OF_EXECUTORS"]

    s3_key = root["AWS_ACCESS_KEY_ID"]
    s3_password = root["AWS_SECRET_ACCESS_KEY"]
    endpoint = root["END_POINT"]

    mssql_config = {
        "connection_url": root["mssql_connection_url"],
        "username": root["mssql_username"],
        "password": root["mssql_pwd"],
        "database": root["mssql_db"],
    }

    app_name = re.sub(
        pattern=r"\{v\}",
        repl=vault_env,
        string=job_name + "_etl_" + file_date,
    )
    logger.info(f"app_name[{app_name}]")

    spark = get_spark_session_v2(
        app_name,
        master_url,
        driver_memory,
        executor_memory,
        driver_cores,
        executor_cores,
        max_number_of_executors,
    )

    report_yaml_full_path = report_yaml_path
    logger.info(f"report_yaml_full_path[{report_yaml_full_path}]")

    s3_client = boto3.client(
        "s3",
        aws_access_key_id=s3_key,
        aws_secret_access_key=s3_password,
        endpoint_url=endpoint,
    )

    return spark, mssql_config, report_yaml_full_path, s3_client
